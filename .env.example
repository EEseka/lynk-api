# Copy to .env and fill in. The dev profile expects every one of these.
SPRING_PROFILES_ACTIVE=dev

# Postgres. Dev reads the host and username from application-dev.yaml, so only the password is here.
POSTGRES_PASSWORD=

# Supabase Storage, for profile pictures
SUPABASE_SERVICE_KEY=

# Redis, for the trending spot cache and rate limiting
REDIS_PASSWORD=

# RabbitMQ, the event bus between modules
RABBITMQ_PASSWORD=

# Auth. The JWT secret must be base64 and at least 32 bytes once decoded.
JWT_SECRET_BASE64=

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Google Sign-In and Places
GOOGLE_CLIENT_ID=
GOOGLE_PLACES_KEY=

# Paystack. A test key is enough for everything except a live payout.
PAYSTACK_SECRET_KEY=

# Brevo SMTP
MAIL_WITH_BREVO_PASSWORD=

# Firebase push. Only deployed environments set this, locally the service account file at
# app/src/main/resources/firebase-credentials/ is used instead.
# FIREBASE_CREDENTIALS_JSON=